# Host-side development. Docker Compose does not use REDIS_URL from this file.
# The app container always receives redis://redis:6379.

PORT=3000
REDIS_URL=redis://127.0.0.1:6379
WORKER_CONCURRENCY=10
LOG_LEVEL=info
SERVICE_NAME=distributed-task-queue

# Used only when REDIS_URL is unset.
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=
