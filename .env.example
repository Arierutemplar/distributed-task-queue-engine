# Copy to .env and fill in the blanks. Never commit .env (it is git-ignored).
# Avoid `$`, quotes and spaces in secret values: Docker Compose interpolates `$`.
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

NODE_ENV=development
PORT=3000
# all = HTTP API + worker in one process; api / worker run a single role.
PROCESS_ROLE=all
LOG_LEVEL=info
SERVICE_NAME=distributed-task-queue

# --- Runtime secrets (optional: --profile secrets) ----------------------------------------
# env is the default; Vault loading runs before config validation and any Redis/client startup.
SECRETS_PROVIDER=env
# 0 disables periodic refresh. POST /admin/api/secrets/reload refreshes immediately.
SECRETS_REFRESH_INTERVAL_MS=0
# Optional file containing the complete API_KEYS value; mount it into every configured container.
# Used only with SECRETS_PROVIDER=env. An empty file revokes all previously configured keys.
API_KEYS_FILE=
# Compose: http://openbao:8200; host development: http://localhost:8200.
# External Vault/OpenBao endpoints require HTTPS; never embed credentials in the URL.
VAULT_ADDR=http://openbao:8200
VAULT_AUTH_METHOD=token
VAULT_TOKEN=
# AppRole mode requires both IDs; the login token is used only to read the startup secret.
VAULT_ROLE_ID=
VAULT_SECRET_ID=
VAULT_APPROLE_PATH=approle
# HTTP KV v2 path, not the CLI path: <mount>/data/<secret> (e.g. secret/data/task-queue).
VAULT_SECRET_PATH=secret/data/task-queue
VAULT_NAMESPACE=
VAULT_TIMEOUT_MS=5000
# Development OpenBao root token ONLY; the dev server is in-memory and prints it at startup.
VAULT_DEV_ROOT_TOKEN=local-openbao-root-token
# Vault wins for sensitive keys it returns; other env settings are retained.
# Supported: REDIS_URL/USERNAME/PASSWORD, REDIS_SENTINEL_USERNAME/PASSWORD, API_KEYS,
# ADMIN_PASSWORD, OIDC_CLIENT_SECRET, SESSION_SECRET, AUDIT_WORM_ACCESS_KEY_ID/SECRET_ACCESS_KEY.
# Missing Vault configuration, rejection, timeout or invalid KV v2 data aborts startup.
# Values are never logged or written to .env. API_KEYS can be refreshed without restarting;
# Redis, OIDC, admin and archive credentials still require a restart.

# --- Redis --------------------------------------------------------------------------------
# Docker Compose standalone: containers use the in-network `redis` service with REDIS_PASSWORD;
#   REDIS_URL from this file is ignored there (Compose forces it to empty; Vault may supply it).
# Local development (`npm run dev`): without Sentinel, REDIS_URL wins over host/port/password.
#   - Leave REDIS_URL empty to use the Compose Redis published on 127.0.0.1:REDIS_PORT,
#     authenticated with REDIS_PASSWORD.
#   - Or point REDIS_URL at a managed Redis (rediss:// for TLS).
# REDIS_URL=rediss://default:<password>@your-redis-host:6379
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Required by Docker Compose (protects its Redis). Example only: change-me-redis-password
REDIS_PASSWORD=
REDIS_USERNAME=
# Both fields select Sentinel and take precedence over REDIS_URL; blank means standalone.
# Compose HA example: redis-sentinel-1:26379,redis-sentinel-2:26379,redis-sentinel-3:26379
REDIS_SENTINEL_HOSTS=
REDIS_SENTINEL_MASTER_NAME=
# Separate control-plane credentials, not the Redis data password. Local Sentinels use
# requirepass when this password is set; keep username empty for the demo's default user.
REDIS_SENTINEL_USERNAME=
REDIS_SENTINEL_PASSWORD=
# The HA profile is intended for in-network clients; external deployments must advertise
# data-node addresses reachable from the client (Docker bridge addresses aren't host endpoints).
# Optional docker-compose.ha.yml overlay: stable IPs allow container-stop failover without
# resolving a stopped container's disappearing DNS record. Use in a fresh/isolated project.
# If the subnet conflicts with another network, change all three values together.
REDIS_HA_SUBNET=172.30.0.0/24
REDIS_HA_PRIMARY_IP=172.30.0.10
REDIS_HA_REPLICA_IP=172.30.0.11

# --- Worker and retries --------------------------------------------------------------------
WORKER_CONCURRENCY=10
# 0 disables each admission limit. Inflight includes waiting, active and delayed retries.
QUEUE_MAX_WAITING=0
TENANT_MAX_INFLIGHT=0
JOB_TIMEOUT_MS=30000
SHUTDOWN_TIMEOUT_MS=25000
# Attempts per task (first run included) and the base of the exponential backoff:
# delays are TASK_BACKOFF_DELAY_MS, 2x, 4x...
TASK_MAX_ATTEMPTS=5
TASK_BACKOFF_DELAY_MS=2000

# Billing mock and its circuit breaker.
BILLING_FAILURE_RATE=0.2
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_TIMEOUT_MS=30000

# --- HTTP edge -----------------------------------------------------------------------------
# Per-IP limit on /api; RATE_LIMIT_MAX=0 disables it.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
# Per-tenant quota (all keys of one tenant share it) in the same window; 0 disables it.
RATE_LIMIT_TENANT_MAX=0
CORS_ORIGINS=*
# Number of trusted reverse proxies in front of the app (for client IPs in limits/audit).
TRUST_PROXY=0
METRICS_ENABLED=true

# --- Task API keys (X-API-Key header) ------------------------------------------------------
# Comma-separated, each key at least 32 characters, no duplicates.
#   key                -> legacy entry: the tenant is derived from the key itself.
#   tenantId:key       -> the key belongs to a stable tenant (letters, digits, _ and -).
# Rotation without losing access to existing tasks: add the new key under the same tenant,
# move clients, then remove the old one, e.g.
#   API_KEYS=acme:<old-key>,acme:<new-key>
# A legacy key's tenant is "key-<first 16 hex of sha256(key)>"; keep its tasks visible with
#   API_KEYS=<legacy-key>,key-<that-hash>:<new-key>
# Required when NODE_ENV=production after env/Vault loading; in development an empty value
# leaves the API open and every caller shares one tenant.
# Example only: API_KEYS=acme:replace-with-a-random-key-of-32-chars-min
API_KEYS=

# --- Admin (/admin/queues, /admin/api) -----------------------------------------------------
# basic is backward compatible; disabled (503) until ADMIN_PASSWORD is set (12+ characters).
ADMIN_AUTH_MODE=basic
# Example only, never use it as-is: ADMIN_PASSWORD=change-me-to-a-long-random-value
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# After this many rejected logins per client IP within the window, /admin answers 429.
ADMIN_AUTH_MAX_FAILURES=10
ADMIN_AUTH_WINDOW_MS=900000
# Admin audit trail kept in the Redis stream <SERVICE_NAME>:audit:admin (approximate cap).
# 0 keeps audit records in the logs only.
AUDIT_LOG_MAX_ENTRIES=10000

# --- Immutable audit archive (optional: --profile compliance) ------------------------------
# Disabled by default. Missing writer credentials logs a warning and keeps Redis/logs only.
AUDIT_WORM_ENABLED=false
# Compose uses the in-network MinIO. For npm run dev: http://localhost:9000.
# Leave empty to use AWS S3's regional endpoint. Non-local endpoints require HTTPS.
AUDIT_WORM_ENDPOINT=http://minio:9000
AUDIT_WORM_REGION=us-east-1
AUDIT_WORM_BUCKET=audit-worm
# Set both to enable the sink; the local minio-init provisioner creates this restricted user.
# Local-only examples: local-audit-writer / local-audit-writer-change-me
AUDIT_WORM_ACCESS_KEY_ID=
AUDIT_WORM_SECRET_ACCESS_KEY=
AUDIT_WORM_FORCE_PATH_STYLE=true
# GOVERNANCE can be bypassed by privileged administrators; COMPLIANCE cannot be shortened.
AUDIT_WORM_LOCK_MODE=GOVERNANCE
AUDIT_WORM_RETENTION_DAYS=30
# One attempt per event, bounded timeout; failures are logged and never fail admin requests.
AUDIT_WORM_TIMEOUT_MS=5000
# Opt-in durable Redis delivery. Direct preserves the historical best-effort sink.
AUDIT_WORM_DELIVERY=direct
AUDIT_OUTBOX_ATTEMPTS=5
AUDIT_OUTBOX_BACKOFF_MS=1000
AUDIT_OUTBOX_CONCURRENCY=2
# Reconciliation retains terminal originals indefinitely; see the cleanup runbook.
DLQ_RECONCILE_ENABLED=false
MAINTENANCE_INTERVAL_MS=30000
MAINTENANCE_BATCH_SIZE=100
# Enable only with docker-compose.production.yml and the production runbook.
PRODUCTION_HARDENING_ENABLED=false
# Local MinIO administration defaults only; change before non-local use.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=local-minio-root-change-me

# --- OIDC / SSO (optional: docker compose --profile auth up -d) -----------------------------
# Only used in oidc mode. For Compose, JWKS/token requests use the internal Keycloak URL.
# For npm run dev on the host, set OIDC_ISSUER_URL=http://localhost:8080/realms/task-queue.
# Tokens MUST contain the public issuer and audience task-queue-admin.
OIDC_ISSUER_URL=http://keycloak:8080/realms/task-queue
OIDC_PUBLIC_ISSUER_URL=http://localhost:8080/realms/task-queue
OIDC_CLIENT_ID=task-queue-admin
# The imported local client is public (PKCE); confidential production clients need a secret.
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/admin/callback
# Required in oidc mode, 32+ random characters, identical across API replicas.
SESSION_SECRET=
# Local profile ONLY: admin / local-admin-change-me and viewer / local-viewer-change-me.
# These are fixed by ops/keycloak/realm-export.json, not configurable via these comments.
# viewer can read; all writes under /admin return 403 and are audited.
# Production: HTTPS for all OIDC URLs, Secure cookies, change users/passwords, disable
# direct access grants, use a confidential client and managed Keycloak (never start-dev).

# --- Tracing (optional) --------------------------------------------------------------------
# OpenTelemetry over OTLP/HTTP. Both OTEL_ENABLED=true and an endpoint are required.
OTEL_ENABLED=false
# Collector base URL; the exporter appends /v1/traces. For Compose: http://otel-collector:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
# Optional OpenTelemetry service name; falls back to SERVICE_NAME.
OTEL_SERVICE_NAME=

# --- Optional observability profile --------------------------------------------------------
# Local-only development defaults; change the Grafana password before use.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=local-observability-only
GRAFANA_PORT=3001
JAEGER_PORT=16686
PROMETHEUS_PORT=9090
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318

# --- Verified encrypted off-host backups (optional operations overlay/profile) --------------
# Bucket must be versioned and provisioned with S3 Object Lock. Production requires HTTPS.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=us-east-1
# Both credentials or the AWS credential chain; dedicated Put/Get/retention, no Delete/Bypass.
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Exactly 64 random hexadecimal characters (32 bytes); keep a separate recoverable copy.
BACKUP_ENCRYPTION_KEY=
BACKUP_KEY_ID=v1
BACKUP_RETENTION_DAYS=90
BACKUP_INTERVAL_MS=300000
BACKUP_TIMEOUT_MS=240000
BACKUP_MAX_BYTES=1073741824
BACKUP_RPO_SECONDS=900
BACKUP_RTO_SECONDS=900
# Native host operations CLI only: custom Redis TLS CA path (mount/use a custom image in Compose).
BACKUP_REDIS_CA_FILE=
# Separate least-privileged KV v2 secret/auth identity for the backup container.
BACKUP_SECRETS_PROVIDER=env
BACKUP_VAULT_AUTH_METHOD=token
BACKUP_VAULT_TOKEN=
BACKUP_VAULT_ROLE_ID=
BACKUP_VAULT_SECRET_ID=
BACKUP_VAULT_SECRET_PATH=secret/data/task-queue-backup
OPERATIONS_IMAGE=distributed-task-queue-operations:local
