# Copy to .env and fill in the blanks. Never commit .env (it is git-ignored).
# Avoid `$`, quotes and spaces in secret values: Docker Compose interpolates `$`.
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

NODE_ENV=development
PORT=3000
# all = HTTP API + worker in one process; api / worker run a single role.
PROCESS_ROLE=all
LOG_LEVEL=info
SERVICE_NAME=distributed-task-queue

# --- Redis --------------------------------------------------------------------------------
# Docker Compose: containers ALWAYS use the in-network `redis` service with REDIS_PASSWORD;
#   REDIS_URL from this file is ignored there (Compose forces it to empty).
# Local development (`npm run dev`): REDIS_URL wins over REDIS_HOST/PORT/PASSWORD.
#   - Leave REDIS_URL empty to use the Compose Redis published on 127.0.0.1:REDIS_PORT,
#     authenticated with REDIS_PASSWORD.
#   - Or point REDIS_URL at a managed Redis (rediss:// for TLS).
# REDIS_URL=rediss://default:<password>@your-redis-host:6379
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Required by Docker Compose (protects its Redis). Example only: change-me-redis-password
REDIS_PASSWORD=

# --- Worker and retries --------------------------------------------------------------------
WORKER_CONCURRENCY=10
JOB_TIMEOUT_MS=30000
SHUTDOWN_TIMEOUT_MS=25000
# Attempts per task (first run included) and the base of the exponential backoff:
# delays are TASK_BACKOFF_DELAY_MS, 2x, 4x...
TASK_MAX_ATTEMPTS=5
TASK_BACKOFF_DELAY_MS=2000

# Billing mock and its circuit breaker.
BILLING_FAILURE_RATE=0.2
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_TIMEOUT_MS=30000

# --- HTTP edge -----------------------------------------------------------------------------
# Per-IP limit on /api; RATE_LIMIT_MAX=0 disables it.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
# Per-tenant quota (all keys of one tenant share it) in the same window; 0 disables it.
RATE_LIMIT_TENANT_MAX=0
CORS_ORIGINS=*
# Number of trusted reverse proxies in front of the app (for client IPs in limits/audit).
TRUST_PROXY=0
METRICS_ENABLED=true

# --- Task API keys (X-API-Key header) ------------------------------------------------------
# Comma-separated, each key at least 32 characters, no duplicates.
#   key                -> legacy entry: the tenant is derived from the key itself.
#   tenantId:key       -> the key belongs to a stable tenant (letters, digits, _ and -).
# Rotation without losing access to existing tasks: add the new key under the same tenant,
# move clients, then remove the old one, e.g.
#   API_KEYS=acme:<old-key>,acme:<new-key>
# A legacy key's tenant is "key-<first 16 hex of sha256(key)>"; keep its tasks visible with
#   API_KEYS=<legacy-key>,key-<that-hash>:<new-key>
# Required when NODE_ENV=production (and by Docker Compose); in development an empty value
# leaves the API open and every caller shares one tenant.
# Example only: API_KEYS=acme:replace-with-a-random-key-of-32-chars-min
API_KEYS=

# --- Admin (/admin/queues, /admin/api) -----------------------------------------------------
# Disabled (503) until ADMIN_PASSWORD is set; it must be at least 12 characters.
# Example only, never use it as-is: ADMIN_PASSWORD=change-me-to-a-long-random-value
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# After this many rejected logins per client IP within the window, /admin answers 429.
ADMIN_AUTH_MAX_FAILURES=10
ADMIN_AUTH_WINDOW_MS=900000
# Admin audit trail kept in the Redis stream <SERVICE_NAME>:audit:admin (approximate cap).
# 0 keeps audit records in the logs only.
AUDIT_LOG_MAX_ENTRIES=10000

# --- Tracing (optional) --------------------------------------------------------------------
# OpenTelemetry over OTLP/HTTP. Both OTEL_ENABLED=true and an endpoint are required.
OTEL_ENABLED=false
# Collector base URL; the exporter appends /v1/traces. For Compose: http://otel-collector:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
# Optional OpenTelemetry service name; falls back to SERVICE_NAME.
OTEL_SERVICE_NAME=

# --- Optional observability profile --------------------------------------------------------
# Local-only development defaults; change the Grafana password before use.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=local-observability-only
GRAFANA_PORT=3001
JAEGER_PORT=16686
PROMETHEUS_PORT=9090
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
